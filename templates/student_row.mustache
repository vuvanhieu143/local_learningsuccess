{{!
    @template local_learningsuccess/student_row

    Individual student row in priority queue.

    Example context (json):
    {
        "standalone": true,
        "userid": 3,
        "courseid": 2,
        "fullname": "Sam Student",
        "student_url": "#",
        "profile_url": "#",
        "actionability_level_label": "Urgent Action Required",
        "is_urgent": true,
        "is_follow_up": false,
        "is_recommend": false,
        "is_monitor": false,
        "summary_reason": "Low activity in last 14 days",
        "signals": [
            {
                "message": "Inactive for 14 days"
            }
        ]
    }
}}
{{#standalone}}<ul>{{/standalone}}
<li class="list-group-item list-group-item-action d-flex flex-column flex-md-row justify-content-between align-items-md-center p-3 mb-2 border rounded shadow-sm {{#is_urgent}}border-danger{{/is_urgent}} {{#is_follow_up}}border-primary{{/is_follow_up}}"
    data-userid="{{userid}}"
    data-courseid="{{courseid}}">

    <div class="d-flex align-items-center mb-2 mb-md-0">
        <div class="me-3">
            <span class="badge rounded-pill p-2 text-uppercase fw-bold 
                {{#is_urgent}}text-bg-danger text-white{{/is_urgent}}
                {{#is_follow_up}}text-bg-primary text-white{{/is_follow_up}}
                {{#is_recommend}}text-bg-warning text-dark{{/is_recommend}}
                {{#is_monitor}}text-bg-secondary text-white{{/is_monitor}}
                {{#status_is_nodata}}text-bg-secondary text-white{{/status_is_nodata}}
                {{^is_urgent}}{{^is_follow_up}}{{^is_recommend}}{{^is_monitor}}{{^status_is_nodata}}text-bg-info text-white{{/status_is_nodata}}{{/is_monitor}}{{/is_recommend}}{{/is_follow_up}}{{/is_urgent}}">
                {{#is_urgent}}<i class="fa fa-fire me-1" aria-hidden="true"></i>{{/is_urgent}}
                {{#is_follow_up}}<i class="fa fa-clock-o me-1" aria-hidden="true"></i>{{/is_follow_up}}
                {{#is_recommend}}<i class="fa fa-lightbulb-o me-1" aria-hidden="true"></i>{{/is_recommend}}
                {{#is_monitor}}<i class="fa fa-eye me-1" aria-hidden="true"></i>{{/is_monitor}}
                {{#status_is_nodata}}<i class="fa fa-question-circle me-1" aria-hidden="true"></i>{{/status_is_nodata}}
                {{actionability_level_label}}
            </span>
        </div>

        <div>
            <div class="d-flex align-items-center flex-wrap mb-1">
                <h3 class="h6 mb-0 fw-bold me-2">
                    <a href="{{student_url}}" class="text-dark text-decoration-none">
                        {{fullname}}
                    </a>
                </h3>
                {{#struggle_tag}}
                    <span class="badge {{class}} small px-2 py-1 me-2" title="{{label}}">
                        <i class="fa {{icon}} me-1" aria-hidden="true"></i>{{label}}
                    </span>
                {{/struggle_tag}}
                {{#risk_source_label}}
                    <span class="badge bg-light text-dark border small px-2 py-1 me-2 risk-source-badge" title="{{risk_source_tooltip}}">
                        <i class="fa {{risk_source_icon}} me-1" aria-hidden="true"></i>{{risk_source_label}}
                    </span>
                {{/risk_source_label}}
                <a href="{{profile_url}}" class="text-muted small me-2" target="_blank" rel="noopener" title="Moodle Profile">
                    <i class="fa fa-external-link" aria-hidden="true"></i>
                </a>
            </div>

            {{#summary_reason}}
                <div class="small fw-bold text-dark mb-1">
                    {{summary_reason}}
                </div>
            {{/summary_reason}}

            <div class="text-muted small">
                {{#signals}}
                    <span class="me-2 d-inline-block">
                        <i class="fa fa-exclamation-circle text-warning me-1" aria-hidden="true"></i>
                        {{message}}
                    </span>
                {{/signals}}
                {{^signals}}
                    <span class="text-success"><i class="fa fa-check-circle me-1" aria-hidden="true"></i>{{#str}}ontrack, local_learningsuccess{{/str}}</span>
                {{/signals}}
            </div>
        </div>
    </div>

    <div class="d-flex align-items-center mt-2 mt-md-0">
        {{#is_follow_up}}
            <a href="{{student_url}}" class="btn btn-primary btn-sm me-2 fw-bold">
                <i class="fa fa-calendar-check-o me-1" aria-hidden="true"></i>{{#str}}action_review_followup, local_learningsuccess{{/str}}
            </a>
        {{/is_follow_up}}
        {{^is_follow_up}}
            <button type="button" 
                    class="btn btn-outline-success btn-sm btn-quick-contact me-2" 
                    data-userid="{{userid}}" 
                    data-courseid="{{courseid}}"
                    data-fullname="{{fullname}}"
                    data-type="checkin"
                    data-has-active="{{#has_active_intervention}}true{{/has_active_intervention}}"
                    aria-label="{{#str}}action_quick_contact, local_learningsuccess{{/str}}: {{fullname}}">
                <i class="fa fa-paper-plane-o me-1" aria-hidden="true"></i>{{#str}}action_checkin, local_learningsuccess{{/str}}
            </button>
            <button type="button" 
                    class="btn btn-primary btn-sm btn-record-intervention me-2" 
                    data-userid="{{userid}}" 
                    data-courseid="{{courseid}}"
                    data-fullname="{{fullname}}"
                    data-has-active="{{#has_active_intervention}}true{{/has_active_intervention}}"
                    aria-label="{{#str}}action_create_intervention, local_learningsuccess{{/str}}: {{fullname}}">
                <i class="fa fa-plus-circle me-1" aria-hidden="true"></i>{{#str}}action_create_intervention, local_learningsuccess{{/str}}
            </button>
        {{/is_follow_up}}
        <a href="{{student_url}}" class="btn btn-outline-secondary btn-sm" title="{{#str}}action_view_student, local_learningsuccess{{/str}}" aria-label="{{#str}}action_view_student, local_learningsuccess{{/str}}: {{fullname}}">
            <i class="fa fa-chevron-right" aria-hidden="true"></i>
        </a>
    </div>
</li>
{{#standalone}}</ul>{{/standalone}}
