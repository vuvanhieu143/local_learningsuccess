{{!
    @template local_learningsuccess/student_row

    Individual student row in priority queue.
}}
<div class="list-group-item list-group-item-action d-flex flex-column flex-md-row justify-content-between align-items-md-center p-3 mb-2 border rounded shadow-sm"
     data-userid="{{userid}}"
     data-courseid="{{courseid}}"
     role="listitem">

    <div class="d-flex align-items-center mb-2 mb-md-0">
        <div class="mr-3">
            <span class="badge badge-pill p-2 text-uppercase font-weight-bold 
                {{#status_is_critical}}badge-danger text-white{{/status_is_critical}}
                {{#status_is_atrisk}}badge-warning text-dark{{/status_is_atrisk}}
                {{#status_is_monitor}}badge-info text-white{{/status_is_monitor}}
                {{#status_is_healthy}}badge-success text-white{{/status_is_healthy}}"
                aria-label="{{#str}}field_status, local_learningsuccess{{/str}}: {{status_label}}">
                {{#status_is_critical}}<i class="fa fa-exclamation-circle mr-1" aria-hidden="true"></i>{{/status_is_critical}}
                {{#status_is_atrisk}}<i class="fa fa-exclamation-triangle mr-1" aria-hidden="true"></i>{{/status_is_atrisk}}
                {{#status_is_monitor}}<i class="fa fa-info-circle mr-1" aria-hidden="true"></i>{{/status_is_monitor}}
                {{#status_is_healthy}}<i class="fa fa-check-circle mr-1" aria-hidden="true"></i>{{/status_is_healthy}}
                {{status_label}}
            </span>
        </div>

        <div>
            <div class="d-flex align-items-center flex-wrap mb-1">
                <h3 class="h6 mb-0 font-weight-bold mr-2">
                    <a href="{{student_url}}" class="text-dark text-decoration-none">
                        {{fullname}}
                    </a>
                </h3>
                {{#struggle_tag}}
                    <span class="badge {{class}} small px-2 py-1" title="{{label}}">
                        <i class="fa {{icon}} mr-1" aria-hidden="true"></i>{{label}}
                    </span>
                {{/struggle_tag}}
            </div>

            <div class="text-muted small">
                {{#signals}}
                    <span class="mr-2 d-inline-block">
                        <i class="fa fa-exclamation-circle text-warning mr-1" aria-hidden="true"></i>
                        {{message}}
                    </span>
                {{/signals}}
                {{^signals}}
                    <span class="text-success"><i class="fa fa-check-circle mr-1" aria-hidden="true"></i>{{#str}}ontrack, local_learningsuccess{{/str}}</span>
                {{/signals}}
            </div>
        </div>
    </div>

    <div class="d-flex align-items-center mt-2 mt-md-0">
        <a href="{{student_url}}" class="btn btn-outline-primary btn-sm mr-2" aria-label="{{#str}}action_view_student, local_learningsuccess{{/str}}: {{fullname}}">
            <i class="fa fa-eye mr-1" aria-hidden="true"></i>{{#str}}action_view_student, local_learningsuccess{{/str}}
        </a>
        <button type="button" 
                class="btn btn-outline-success btn-sm btn-quick-contact mr-2" 
                data-userid="{{userid}}" 
                data-fullname="{{fullname}}"
                data-type="CONTACT"
                aria-label="{{#str}}action_quick_contact, local_learningsuccess{{/str}}: {{fullname}}">
            <i class="fa fa-commenting-o mr-1" aria-hidden="true"></i>{{#str}}action_quick_contact, local_learningsuccess{{/str}}
        </button>
        <button type="button" 
                class="btn btn-primary btn-sm btn-record-intervention" 
                data-userid="{{userid}}" 
                data-fullname="{{fullname}}"
                aria-label="{{#str}}action_create_intervention, local_learningsuccess{{/str}}: {{fullname}}">
            <i class="fa fa-plus-circle mr-1" aria-hidden="true"></i>{{#str}}action_create_intervention, local_learningsuccess{{/str}}
        </button>
    </div>
</div>

