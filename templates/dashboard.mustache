{{!
    @template local_learningsuccess/dashboard

    Main teacher dashboard template.

    Example context (json):
    {
        "courseid": 2,
        "healthy_count": 25,
        "monitor_count": 8,
        "atrisk_count": 3,
        "critical_count": 1,
        "total_students": 37,
        "active_interventions": 2,
        "has_recent_improvements": true,
        "recent_improvements": [
            {
                "fullname": "Sam Student",
                "completed_date": "16 Sep 2026",
                "action_note": "Sent message and extended deadline"
            }
        ],
        "has_groups": false,
        "has_priorities": true,
        "priorities": [
            {
                "userid": 3,
                "courseid": 2,
                "fullname": "Sam Student",
                "student_url": "#",
                "profile_url": "#",
                "actionability_level_label": "Urgent Action Required",
                "is_urgent": true,
                "summary_reason": "Low activity in last 14 days",
                "signals": [
                    {
                        "message": "Inactive for 14 days"
                    }
                ]
            }
        ]
    }
}}
<div class="local-learningsuccess-dashboard" data-region="dashboard" data-courseid="{{courseid}}">
    {{> local_learningsuccess/class_pulse }}

    {{#has_attention_needed}}
    <div class="alert alert-warning border-warning shadow-sm d-flex align-items-center mb-4" role="alert">
        <i class="fa fa-bell fa-2x me-3 text-warning" aria-hidden="true"></i>
        <div class="flex-grow-1">
            <h3 class="h6 fw-bold mb-1">{{#str}}what_needs_attention, local_learningsuccess{{/str}}</h3>
            <p class="mb-0 small">{{attention_desc}}</p>
        </div>
    </div>
    {{/has_attention_needed}}

    {{#has_recent_improvements}}
    <div class="card shadow-sm border-0 mb-4 bg-light border-start border-5 border-success" role="region" aria-labelledby="improvements-heading">
        <div class="card-body">
            <h2 id="improvements-heading" class="h5 card-title text-success d-flex align-items-center mb-3">
                <i class="fa fa-line-chart text-success me-2" aria-hidden="true"></i>
                {{#str}}recent_improvements, local_learningsuccess{{/str}}
            </h2>
            <div class="row">
                {{#recent_improvements}}
                <div class="col-md-6 col-lg-3 mb-2">
                    <div class="p-3 bg-white rounded shadow-sm border h-100">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <strong class="text-dark">{{fullname}}</strong>
                            <span class="badge text-bg-success small">{{#str}}outcome_improved, local_learningsuccess{{/str}}</span>
                        </div>
                        <div class="small text-muted mb-1">
                            <i class="fa fa-calendar-check-o me-1" aria-hidden="true"></i>{{completed_date}}
                        </div>
                        <div class="small text-secondary fst-italic text-truncate" title="{{action_note}}">
                            "{{action_note}}"
                        </div>
                    </div>
                </div>
                {{/recent_improvements}}
            </div>
        </div>
    </div>
    {{/has_recent_improvements}}

    {{#has_recently_handled}}
    <div class="card shadow-sm border-0 mb-4 bg-light border-start border-5 border-info" role="region" aria-labelledby="recently-handled-heading">
        <div class="card-body">
            <h2 id="recently-handled-heading" class="h5 card-title text-info d-flex align-items-center mb-3">
                <i class="fa fa-history text-info me-2" aria-hidden="true"></i>
                {{#str}}recently_handled, local_learningsuccess{{/str}}
            </h2>
            <div class="row">
                {{#recently_handled}}
                <div class="col-md-6 col-lg-3 mb-2">
                    <div class="p-3 bg-white rounded shadow-sm border h-100">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <strong class="text-dark">
                                <a href="{{student_url}}" class="text-dark text-decoration-none">{{fullname}}</a>
                            </strong>
                            <span class="badge text-bg-secondary small">{{status_label}}</span>
                        </div>
                        <div class="small text-muted mb-1">
                            <i class="fa fa-clock-o me-1" aria-hidden="true"></i>{{handled_date}}
                        </div>
                        {{#action_note}}
                        <div class="small text-secondary fst-italic text-truncate" title="{{action_note}}">
                            "{{action_note}}"
                        </div>
                        {{/action_note}}
                    </div>
                </div>
                {{/recently_handled}}
            </div>
        </div>
    </div>
    {{/has_recently_handled}}

    <div class="card shadow-sm border-0 mb-4" role="region" aria-labelledby="priorities-heading">
        <div class="card-body">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-3">
                <h2 id="priorities-heading" class="h4 card-title text-primary d-flex align-items-center mb-2 mb-md-0">
                    <i class="fa fa-fire text-danger me-2" aria-hidden="true"></i>
                    {{#str}}todayspriorities, local_learningsuccess{{/str}}
                </h2>

                <div class="d-flex align-items-center">
                    {{#has_groups}}
                        <div class="me-2 d-flex align-items-center">
                            <label for="learning-success-group-select" class="me-1 mb-0 small text-muted fw-bold visually-hidden">
                                {{#str}}filter_by_group, local_learningsuccess{{/str}}
                            </label>
                            <select id="learning-success-group-select" class="form-select form-select-sm" onchange="location.href='?courseid={{courseid}}&groupid=' + this.value;" aria-label="{{#str}}filter_by_group, local_learningsuccess{{/str}}">
                                <option value="0">{{#str}}all_groups, local_learningsuccess{{/str}}</option>
                                {{#groups}}
                                    <option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>
                                {{/groups}}
                            </select>
                        </div>
                    {{/has_groups}}

                    <button type="button" class="btn btn-outline-secondary btn-sm btn-refresh-dashboard" aria-label="{{#str}}refresh_help, local_learningsuccess{{/str}}">
                        <i class="fa fa-refresh me-1" aria-hidden="true"></i>{{#str}}refresh, local_learningsuccess{{/str}}
                    </button>
                </div>
            </div>

            <!-- ARIA Live Region for dynamic state updates -->
            <div class="priority-queue-container" aria-live="polite" aria-atomic="true" id="priority-list-container">
                {{#has_priorities}}
                    <ul class="list-group list-group-flush">
                        {{#priorities}}
                            {{> local_learningsuccess/student_row }}
                        {{/priorities}}
                    </ul>
                {{/has_priorities}}
                {{^has_priorities}}
                    <div class="alert alert-success d-flex align-items-center my-3" role="status">
                        <i class="fa fa-check-circle fa-2x me-3 text-success" aria-hidden="true"></i>
                        <div>
                            <h3 class="h6 mb-0">{{#str}}nostudentsatrisk, local_learningsuccess{{/str}}</h3>
                        </div>
                    </div>
                {{/has_priorities}}
            </div>
        </div>
    </div>
</div>
