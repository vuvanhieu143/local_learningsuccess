{{!
    @template local_learningsuccess/student_detail

    Comprehensive student success details view.
}}
<div class="local-learningsuccess-student-detail" data-userid="{{user.id}}" data-courseid="{{courseid}}">
    <!-- Header summary card -->
    <div class="card shadow-sm border-0 mb-4 bg-light">
        <div class="card-body d-flex flex-column flex-md-row justify-content-between align-items-md-center">
            <div>
                <h1 class="h3 font-weight-bold mb-1">{{user.fullname}}</h1>
                <p class="text-muted mb-0"><i class="fa fa-envelope-o mr-1" aria-hidden="true"></i>{{user.email}}</p>
            </div>
            <div class="mt-3 mt-md-0 d-flex align-items-center">
                <span class="badge badge-pill p-2 text-uppercase font-weight-bold mr-3
                    {{#status_is_critical}}badge-danger text-white{{/status_is_critical}}
                    {{#status_is_atrisk}}badge-warning text-dark{{/status_is_atrisk}}
                    {{#status_is_monitor}}badge-info text-white{{/status_is_monitor}}
                    {{#status_is_healthy}}badge-success text-white{{/status_is_healthy}}"
                    aria-label="{{#str}}field_status, local_learningsuccess{{/str}}: {{status_label}}">
                    {{#status_is_critical}}<i class="fa fa-exclamation-circle mr-1" aria-hidden="true"></i>{{/status_is_critical}}
                    {{#status_is_atrisk}}<i class="fa fa-exclamation-triangle mr-1" aria-hidden="true"></i>{{/status_is_atrisk}}
                    {{#status_is_monitor}}<i class="fa fa-info-circle mr-1" aria-hidden="true"></i>{{/status_is_monitor}}
                    {{#status_is_healthy}}<i class="fa fa-check-circle mr-1" aria-hidden="true"></i>{{/status_is_healthy}}
                    {{status_label}}
                </span>
                <button type="button" 
                        class="btn btn-primary btn-record-intervention" 
                        data-userid="{{user.id}}" 
                        data-fullname="{{user.fullname}}"
                        aria-label="{{#str}}action_create_intervention, local_learningsuccess{{/str}}: {{user.fullname}}">
                    <i class="fa fa-plus-circle mr-1" aria-hidden="true"></i>{{#str}}action_create_intervention, local_learningsuccess{{/str}}
                </button>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Why is this student at risk? (Signals) -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm border-0 h-100" role="region" aria-labelledby="signals-heading">
                <div class="card-header bg-white font-weight-bold text-danger d-flex align-items-center">
                    <i class="fa fa-question-circle mr-2" aria-hidden="true"></i>
                    <h2 id="signals-heading" class="h6 mb-0 text-danger font-weight-bold">{{#str}}whystudentatrisk, local_learningsuccess{{/str}}</h2>
                </div>
                <div class="card-body">
                    {{#has_signals}}
                        {{#signals}}
                            <div class="alert alert-light border mb-2 d-flex align-items-start" role="note">
                                <i class="fa fa-exclamation-triangle text-warning mr-3 mt-1" aria-hidden="true"></i>
                                <div>
                                    <strong class="d-block text-dark">{{message}}</strong>
                                    <span class="badge badge-secondary text-uppercase small">{{severity}}</span>
                                </div>
                            </div>
                        {{/signals}}
                    {{/has_signals}}
                    {{^has_signals}}
                        <p class="text-muted my-3"><i class="fa fa-check text-success mr-2" aria-hidden="true"></i>{{#str}}nononegativesignals, local_learningsuccess{{/str}}</p>
                    {{/has_signals}}
                </div>
            </div>
        </div>

        <!-- Recommended Actions -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm border-0 h-100" role="region" aria-labelledby="recommendations-heading">
                <div class="card-header bg-white font-weight-bold text-primary d-flex align-items-center">
                    <i class="fa fa-lightbulb-o mr-2" aria-hidden="true"></i>
                    <h2 id="recommendations-heading" class="h6 mb-0 text-primary font-weight-bold">{{#str}}recommendedactions, local_learningsuccess{{/str}}</h2>
                </div>
                <div class="card-body">
                    {{#has_recommendations}}
                        {{#recommendations}}
                            <div class="p-3 mb-2 border rounded bg-white">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <h3 class="h6 font-weight-bold text-dark mb-0">{{title}}</h3>
                                    <span class="badge badge-info text-uppercase">{{priority}}</span>
                                </div>
                                <p class="small text-muted mb-2">{{description}}</p>
                                <button type="button" 
                                        class="btn btn-sm btn-outline-primary btn-record-intervention"
                                        data-userid="{{user.id}}"
                                        data-fullname="{{user.fullname}}"
                                        data-type="{{action}}"
                                        data-recommended="{{description}}"
                                        aria-label="{{#str}}applythisaction, local_learningsuccess{{/str}}: {{title}}">
                                    {{#str}}applythisaction, local_learningsuccess{{/str}}
                                </button>
                            </div>
                        {{/recommendations}}
                    {{/has_recommendations}}
                    {{^has_recommendations}}
                        <p class="text-muted my-3">{{#str}}nopendingrecommendations, local_learningsuccess{{/str}}</p>
                    {{/has_recommendations}}
                </div>
            </div>
        </div>
    </div>

    <!-- Intervention History -->
    <div class="card shadow-sm border-0 mb-4" role="region" aria-labelledby="history-heading">
        <div class="card-header bg-white font-weight-bold text-dark d-flex align-items-center">
            <i class="fa fa-history mr-2" aria-hidden="true"></i>
            <h2 id="history-heading" class="h6 mb-0 text-dark font-weight-bold">{{#str}}interventionhistory, local_learningsuccess{{/str}}</h2>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0" aria-label="{{#str}}interventionhistory, local_learningsuccess{{/str}}">
                    <thead class="thead-light">
                        <tr>
                            <th scope="col">{{#str}}field_type, local_learningsuccess{{/str}}</th>
                            <th scope="col">{{#str}}field_reason, local_learningsuccess{{/str}}</th>
                            <th scope="col">{{#str}}field_actual_action, local_learningsuccess{{/str}}</th>
                            <th scope="col">{{#str}}field_status, local_learningsuccess{{/str}}</th>
                            <th scope="col">{{#str}}field_outcome, local_learningsuccess{{/str}}</th>
                            <th scope="col">{{#str}}actions, local_learningsuccess{{/str}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#has_interventions}}
                            {{#interventions}}
                                <tr>
                                    <td class="font-weight-bold">{{type}}</td>
                                    <td class="small">{{reason}}</td>
                                    <td class="small">{{actual_action}}</td>
                                    <td><span class="badge badge-secondary">{{status}}</span></td>
                                    <td>
                                        <span class="badge badge-pill 
                                            {{#outcome_is_improved}}badge-success text-white{{/outcome_is_improved}}
                                            {{#outcome_is_declined}}badge-danger text-white{{/outcome_is_declined}}
                                            {{#outcome_is_no_change}}badge-secondary text-white{{/outcome_is_no_change}}
                                            {{^outcome_is_improved}}{{^outcome_is_declined}}{{^outcome_is_no_change}}badge-light border{{/outcome_is_no_change}}{{/outcome_is_declined}}{{/outcome_is_improved}}"
                                            aria-label="{{#str}}field_outcome, local_learningsuccess{{/str}}: {{outcome}}">
                                            {{#outcome_is_improved}}<i class="fa fa-arrow-up mr-1" aria-hidden="true"></i>{{/outcome_is_improved}}
                                            {{#outcome_is_declined}}<i class="fa fa-arrow-down mr-1" aria-hidden="true"></i>{{/outcome_is_declined}}
                                            {{#outcome_is_no_change}}<i class="fa fa-minus mr-1" aria-hidden="true"></i>{{/outcome_is_no_change}}
                                            {{outcome}}
                                        </span>
                                    </td>
                                    <td>
                                        {{#can_complete}}
                                            <button type="button" 
                                                    class="btn btn-sm btn-outline-success btn-complete-intervention mr-1" 
                                                    data-id="{{id}}"
                                                    aria-label="{{#str}}action_complete, local_learningsuccess{{/str}}">
                                                <i class="fa fa-check mr-1" aria-hidden="true"></i>{{#str}}action_complete, local_learningsuccess{{/str}}
                                            </button>
                                        {{/can_complete}}
                                        {{#can_dismiss}}
                                            <button type="button" 
                                                    class="btn btn-sm btn-outline-secondary btn-dismiss-intervention" 
                                                    data-id="{{id}}"
                                                    aria-label="{{#str}}action_dismiss, local_learningsuccess{{/str}}">
                                                <i class="fa fa-ban mr-1" aria-hidden="true"></i>{{#str}}action_dismiss, local_learningsuccess{{/str}}
                                            </button>
                                        {{/can_dismiss}}
                                    </td>
                                </tr>
                            {{/interventions}}
                        {{/has_interventions}}
                        {{^has_interventions}}
                            <tr>
                                <td colspan="6" class="text-center text-muted p-4">{{#str}}nointerventionsfound, local_learningsuccess{{/str}}</td>
                            </tr>
                        {{/has_interventions}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
