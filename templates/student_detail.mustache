{{!
    @template local_learningsuccess/student_detail

    Comprehensive student success details view.

    Example context (json):
    {
        "courseid": 2,
        "user": {
            "id": 3,
            "fullname": "Sam Student"
        },
        "profile_url": "#",
        "message_url": "#",
        "status_label": "At Risk",
        "status_is_atrisk": true,
        "status_is_critical": false,
        "status_is_monitor": false,
        "status_is_healthy": false,
        "has_signals": true,
        "signals": [
            {
                "message": "Inactive for 14 days",
                "severity": "high"
            }
        ],
        "has_recommendations": true,
        "recommendations": [
            {
                "title": "Reach Out",
                "description": "Send a supportive message to the student",
                "priority": "High",
                "action": "CONTACT"
            }
        ],
        "has_interventions": false
    }
}}
<div class="local-learningsuccess-student-detail" data-userid="{{user.id}}" data-courseid="{{courseid}}">
    <!-- Header summary card -->
    <div class="card shadow-sm border-0 mb-4 bg-light">
        <div class="card-body d-flex flex-column flex-md-row justify-content-between align-items-md-center">
            <div>
                <h1 class="h3 fw-bold mb-1">{{user.fullname}}</h1>
                <div class="mt-1">
                    <a href="{{profile_url}}" class="btn btn-outline-secondary btn-sm me-2" target="_blank" rel="noopener">
                        <i class="fa fa-user me-1" aria-hidden="true"></i>Moodle Profile
                    </a>
                    <a href="{{message_url}}" class="btn btn-outline-info btn-sm" target="_blank" rel="noopener">
                        <i class="fa fa-comment me-1" aria-hidden="true"></i>{{#str}}action_contact_student, local_learningsuccess{{/str}}
                    </a>
                </div>
            </div>
            <div class="mt-3 mt-md-0 d-flex align-items-center">
                {{#risk_source_label}}
                <span class="badge bg-light text-secondary border small px-2 py-1 me-2" title="{{risk_source_tooltip}}">
                    <i class="fa {{risk_source_icon}} me-1" aria-hidden="true"></i>{{risk_source_label}}
                </span>
                {{/risk_source_label}}
                <span class="badge rounded-pill p-2 text-uppercase fw-bold me-3
                    {{#status_is_critical}}text-bg-danger{{/status_is_critical}}
                    {{#status_is_atrisk}}text-bg-warning{{/status_is_atrisk}}
                    {{#status_is_monitor}}text-bg-info{{/status_is_monitor}}
                    {{#status_is_healthy}}text-bg-success{{/status_is_healthy}}
                    {{#status_is_nodata}}text-bg-secondary{{/status_is_nodata}}">
                    {{#status_is_critical}}<i class="fa fa-exclamation-circle me-1" aria-hidden="true"></i>{{/status_is_critical}}
                    {{#status_is_atrisk}}<i class="fa fa-exclamation-triangle me-1" aria-hidden="true"></i>{{/status_is_atrisk}}
                    {{#status_is_monitor}}<i class="fa fa-info-circle me-1" aria-hidden="true"></i>{{/status_is_monitor}}
                    {{#status_is_healthy}}<i class="fa fa-check-circle me-1" aria-hidden="true"></i>{{/status_is_healthy}}
                    {{#status_is_nodata}}<i class="fa fa-question-circle me-1" aria-hidden="true"></i>{{/status_is_nodata}}
                    {{status_label}}
                </span>
                <button type="button" 
                        class="btn btn-primary btn-record-intervention" 
                        data-userid="{{user.id}}" 
                        data-courseid="{{courseid}}"
                        data-fullname="{{user.fullname}}"
                        data-has-active="{{#has_active_intervention}}true{{/has_active_intervention}}"
                        data-active-status="{{active_intervention.status}}"
                        aria-label="{{#str}}action_create_intervention, local_learningsuccess{{/str}}: {{user.fullname}}">
                    <i class="fa fa-plus-circle me-1" aria-hidden="true"></i>{{#str}}action_create_intervention, local_learningsuccess{{/str}}
                </button>
            </div>
        </div>
    </div>

    {{#has_active_intervention}}
    <div class="alert alert-info border-info shadow-sm d-flex align-items-center mb-4" role="alert">
        <i class="fa fa-info-circle fa-2x me-3 text-info" aria-hidden="true"></i>
        <div class="flex-grow-1">
            <h3 class="h6 mb-1 fw-bold">{{#str}}active_intervention_exists, local_learningsuccess, {{active_intervention.status}}{{/str}}</h3>
            <p class="mb-0 small text-muted">{{#str}}whystudentatrisk, local_learningsuccess{{/str}}</p>
        </div>
    </div>
    {{/has_active_intervention}}

    <div class="row">
        <!-- Why is this student at risk? (Signals) -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm border-0 h-100" role="region" aria-labelledby="signals-heading">
                <div class="card-header bg-white fw-bold text-danger d-flex align-items-center">
                    <i class="fa fa-question-circle me-2" aria-hidden="true"></i>
                    <h2 id="signals-heading" class="h6 mb-0 text-danger fw-bold">{{#str}}whystudentatrisk, local_learningsuccess{{/str}}</h2>
                </div>
                <div class="card-body">
                    {{#has_signals}}
                        {{#signals}}
                            <div class="alert alert-light border mb-2 d-flex flex-column flex-md-row justify-content-between align-items-md-center signal-item-container" role="note" data-signal-type="{{signal_type}}">
                                <div class="d-flex align-items-start me-md-2 mb-2 mb-md-0">
                                    <i class="fa fa-exclamation-triangle text-warning me-3 mt-1" aria-hidden="true"></i>
                                    <div>
                                        <strong class="d-block text-dark">{{message}}</strong>
                                        <span class="badge text-bg-secondary text-uppercase small">{{severity}}</span>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center">
                                    <div class="input-group input-group-sm">
                                        <label for="dismiss-reason-{{signal_type}}" class="visually-hidden">{{#str}}dismiss_reason, local_learningsuccess{{/str}}</label>
                                        <select id="dismiss-reason-{{signal_type}}" class="form-select form-select-sm dismiss-reason-select" aria-label="{{#str}}dismiss_reason, local_learningsuccess{{/str}}">
                                            {{#dismissal_reasons}}
                                                <option value="{{value}}">{{label}}</option>
                                            {{/dismissal_reasons}}
                                        </select>
                                        <button type="button" 
                                                class="btn btn-outline-secondary btn-sm btn-dismiss-signal"
                                                data-courseid="{{courseid}}"
                                                data-userid="{{user.id}}"
                                                data-signal="{{signal_type}}"
                                                title="{{#str}}dismiss_signal, local_learningsuccess{{/str}}"
                                                aria-label="{{#str}}dismiss_signal, local_learningsuccess{{/str}}">
                                            <i class="fa fa-times me-1" aria-hidden="true"></i>{{#str}}dismiss_signal, local_learningsuccess{{/str}}
                                        </button>
                                    </div>
                                </div>
                            </div>
                        {{/signals}}
                    {{/has_signals}}
                    {{^has_signals}}
                        <p class="text-muted my-3"><i class="fa fa-check text-success me-2" aria-hidden="true"></i>{{#str}}nononegativesignals, local_learningsuccess{{/str}}</p>
                    {{/has_signals}}
                </div>
            </div>
        </div>

        <!-- Recommended Actions -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm border-0 h-100" role="region" aria-labelledby="recommendations-heading">
                <div class="card-header bg-white fw-bold text-primary d-flex align-items-center">
                    <i class="fa fa-lightbulb-o me-2" aria-hidden="true"></i>
                    <h2 id="recommendations-heading" class="h6 mb-0 text-primary fw-bold">{{#str}}recommendedactions, local_learningsuccess{{/str}}</h2>
                </div>
                <div class="card-body">
                    {{#has_recommendations}}
                        {{#recommendations}}
                            <div class="p-3 mb-2 border rounded bg-white">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <h3 class="h6 fw-bold text-dark mb-0">{{title}}</h3>
                                    <span class="badge text-bg-info text-uppercase">{{priority}}</span>
                                </div>
                                <p class="small text-muted mb-2">{{description}}</p>
                                <button type="button" 
                                        class="btn btn-sm btn-outline-primary btn-record-intervention"
                                        data-userid="{{user.id}}"
                                        data-courseid="{{courseid}}"
                                        data-fullname="{{user.fullname}}"
                                        data-type="{{action}}"
                                        data-recommended="{{description}}"
                                        aria-label="{{#str}}applythisaction, local_learningsuccess{{/str}}: {{title}}">
                                    {{#str}}applythisaction, local_learningsuccess{{/str}}
                                </button>
                            </div>
                        {{/recommendations}}
                    {{/has_recommendations}}
                    {{^has_recommendations}}
                        <p class="text-muted my-3">{{#str}}nopendingrecommendations, local_learningsuccess{{/str}}</p>
                    {{/has_recommendations}}
                </div>
            </div>
        </div>
    </div>

    <!-- Intervention History -->
    <div class="card shadow-sm border-0 mb-4" role="region" aria-labelledby="history-heading">
        <div class="card-header bg-white fw-bold text-dark d-flex align-items-center">
            <i class="fa fa-history me-2" aria-hidden="true"></i>
            <h2 id="history-heading" class="h6 mb-0 text-dark fw-bold">{{#str}}interventionhistory, local_learningsuccess{{/str}}</h2>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0" aria-label="{{#str}}interventionhistory, local_learningsuccess{{/str}}">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">{{#str}}field_type, local_learningsuccess{{/str}}</th>
                            <th scope="col">{{#str}}field_reason, local_learningsuccess{{/str}}</th>
                            <th scope="col">{{#str}}field_actual_action, local_learningsuccess{{/str}}</th>
                            <th scope="col">{{#str}}field_status, local_learningsuccess{{/str}}</th>
                            <th scope="col">{{#str}}field_outcome, local_learningsuccess{{/str}}</th>
                            <th scope="col">{{#str}}actions, local_learningsuccess{{/str}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#has_interventions}}
                            {{#interventions}}
                                <tr>
                                    <td class="fw-bold">{{type}}</td>
                                    <td class="small">{{reason}}</td>
                                    <td class="small">{{actual_action}}</td>
                                    <td><span class="badge text-bg-secondary">{{status}}</span></td>
                                    <td>
                                        <span class="badge rounded-pill 
                                            {{#outcome_is_improved}}text-bg-success{{/outcome_is_improved}}
                                            {{#outcome_is_declined}}text-bg-danger{{/outcome_is_declined}}
                                            {{#outcome_is_no_change}}text-bg-secondary{{/outcome_is_no_change}}
                                            {{^outcome_is_improved}}{{^outcome_is_declined}}{{^outcome_is_no_change}}text-bg-light border{{/outcome_is_no_change}}{{/outcome_is_declined}}{{/outcome_is_improved}}">
                                            {{#outcome_is_improved}}<i class="fa fa-arrow-up me-1" aria-hidden="true"></i>{{/outcome_is_improved}}
                                            {{#outcome_is_declined}}<i class="fa fa-arrow-down me-1" aria-hidden="true"></i>{{/outcome_is_declined}}
                                            {{#outcome_is_no_change}}<i class="fa fa-minus me-1" aria-hidden="true"></i>{{/outcome_is_no_change}}
                                            {{outcome}}
                                        </span>
                                    </td>
                                    <td>
                                        {{#can_complete}}
                                            <button type="button" 
                                                    class="btn btn-sm btn-outline-success btn-complete-intervention me-1" 
                                                    data-id="{{id}}"
                                                    aria-label="{{#str}}action_complete, local_learningsuccess{{/str}}">
                                                <i class="fa fa-check me-1" aria-hidden="true"></i>{{#str}}action_complete, local_learningsuccess{{/str}}
                                            </button>
                                        {{/can_complete}}
                                        {{#can_dismiss}}
                                            <button type="button" 
                                                    class="btn btn-sm btn-outline-secondary btn-dismiss-intervention" 
                                                    data-id="{{id}}"
                                                    aria-label="{{#str}}action_dismiss, local_learningsuccess{{/str}}">
                                                <i class="fa fa-ban me-1" aria-hidden="true"></i>{{#str}}action_dismiss, local_learningsuccess{{/str}}
                                            </button>
                                        {{/can_dismiss}}
                                    </td>
                                </tr>
                            {{/interventions}}
                        {{/has_interventions}}
                        {{^has_interventions}}
                            <tr>
                                <td colspan="6" class="text-center text-muted p-4">{{#str}}nointerventionsfound, local_learningsuccess{{/str}}</td>
                            </tr>
                        {{/has_interventions}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
