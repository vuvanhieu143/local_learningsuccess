<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/learningsuccess/db" VERSION="20260830" COMMENT="XMLDB file for local_learningsuccess">
  <TABLES>
    <TABLE NAME="local_ls_intervention" COMMENT="Tracks student intervention records and outcomes">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Target student ID"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Target course ID"/>
        <FIELD NAME="teacherid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Intervening teacher ID"/>
        <FIELD NAME="type" TYPE="char" LENGTH="30" NOTNULL="true" SEQUENCE="false" COMMENT="CONTACT, LEARNING_RESOURCE, MISSED_ACTIVITY, EXTENSION, ADVISOR_REFERRAL, OTHER"/>
        <FIELD NAME="reason" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Explanation of risk driving the intervention"/>
        <FIELD NAME="recommended_action" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="System-recommended action description"/>
        <FIELD NAME="actual_action" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Actual action taken by teacher"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="OPEN" SEQUENCE="false" COMMENT="OPEN, IN_PROGRESS, COMPLETED, DISMISSED"/>
        <FIELD NAME="outcome" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="UNKNOWN" SEQUENCE="false" COMMENT="IMPROVED, NO_CHANGE, DECLINED, UNKNOWN"/>
        <FIELD NAME="before_snapshot_id" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Canonical reference to before snapshot record"/>
        <FIELD NAME="after_snapshot_id" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Canonical reference to after snapshot record"/>
        <FIELD NAME="system_outcome" TYPE="char" LENGTH="20" NOTNULL="false" SEQUENCE="false" COMMENT="Automated outcome calculated by evaluator"/>
        <FIELD NAME="teacher_outcome" TYPE="char" LENGTH="20" NOTNULL="false" SEQUENCE="false" COMMENT="Outcome explicitly confirmed by teacher"/>
        <FIELD NAME="before_snapshot" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="JSON snapshot of student metrics prior to intervention"/>
        <FIELD NAME="after_snapshot" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="JSON snapshot of student metrics post intervention"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="completed_at" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="followupat" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Scheduled follow-up timestamp"/>
        <FIELD NAME="resolvedat" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Resolution timestamp"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="userid_idx" UNIQUE="false" FIELDS="userid"/>
        <INDEX NAME="courseid_idx" UNIQUE="false" FIELDS="courseid"/>
        <INDEX NAME="teacherid_idx" UNIQUE="false" FIELDS="teacherid"/>
        <INDEX NAME="status_idx" UNIQUE="false" FIELDS="status"/>
        <INDEX NAME="course_user_idx" UNIQUE="false" FIELDS="courseid, userid"/>
        <INDEX NAME="course_status_outcome_idx" UNIQUE="false" FIELDS="courseid, status, outcome"/>
        <INDEX NAME="followupat_idx" UNIQUE="false" FIELDS="followupat"/>
        <INDEX NAME="before_snapshot_idx" UNIQUE="false" FIELDS="before_snapshot_id"/>
        <INDEX NAME="after_snapshot_idx" UNIQUE="false" FIELDS="after_snapshot_id"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_ls_note" COMMENT="Stores teacher notes and follow-up annotations on interventions">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="interventionid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Associated intervention ID"/>
        <FIELD NAME="authorid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Teacher who wrote the note"/>
        <FIELD NAME="note" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="Body of teacher note"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="interventionid_idx" UNIQUE="false" FIELDS="interventionid"/>
        <INDEX NAME="authorid_idx" UNIQUE="false" FIELDS="authorid"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_ls_snapshot" COMMENT="Before and followup metrics snapshots for intervention outcome evaluation">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="interventionid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Associated intervention ID"/>
        <FIELD NAME="phase" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false" COMMENT="before or followup"/>
        <FIELD NAME="riskscore" TYPE="number" LENGTH="5" DECIMALS="2" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="risklevel" TYPE="char" LENGTH="20" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="completion" TYPE="number" LENGTH="5" DECIMALS="2" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="grade" TYPE="number" LENGTH="5" DECIMALS="2" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="activitylevel" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="overduecount" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="intervention_phase_idx" UNIQUE="false" FIELDS="interventionid, phase"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_ls_signal" COMMENT="Stores derived risk explanation signals for students">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="signal_type" TYPE="char" LENGTH="50" NOTNULL="true" SEQUENCE="false" COMMENT="inactivity, completion, grade_decline, missed_activity, etc."/>
        <FIELD NAME="severity" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="medium" SEQUENCE="false" COMMENT="critical, high, medium, low"/>
        <FIELD NAME="value" TYPE="number" LENGTH="10" DECIMALS="2" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="metadata" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="firstseen" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Timestamp when the signal was first detected"/>
        <FIELD NAME="lastseen" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Timestamp when the signal was most recently observed"/>
        <FIELD NAME="active" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="1 if signal is actively ongoing, 0 if resolved"/>
        <FIELD NAME="dismissed" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="1 if dismissed by teacher override, 0 otherwise"/>
        <FIELD NAME="dismissedby" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Teacher user ID who dismissed the signal"/>
        <FIELD NAME="dismissedat" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Timestamp when signal was dismissed"/>
        <FIELD NAME="dismissreason" TYPE="char" LENGTH="50" NOTNULL="false" SEQUENCE="false" COMMENT="Reason code for dismissal"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="courseid_idx" UNIQUE="false" FIELDS="courseid"/>
        <INDEX NAME="user_course_idx" UNIQUE="false" FIELDS="userid, courseid"/>
        <INDEX NAME="signal_type_idx" UNIQUE="false" FIELDS="signal_type"/>
        <INDEX NAME="user_course_type_idx" UNIQUE="false" FIELDS="userid, courseid, signal_type"/>
        <INDEX NAME="active_dismissed_idx" UNIQUE="false" FIELDS="active, dismissed"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>

